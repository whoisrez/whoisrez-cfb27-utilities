{
  "name": "whoisrez-cfb27-utilities",
  "productName": "CFB 27 Utilities",
  "version": "0.1.0",
  "description": "CFB 27 dynasty utilities with Team Needs and Promotion/Relegation tools",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "prestart": "node scripts/generate-app-icon.cjs",
    "start": "electron-forge start",
    "prepackage": "node scripts/generate-app-icon.cjs",
    "package": "electron-forge package",
    "premake": "node scripts/generate-app-icon.cjs",
    "make": "electron-forge package && node scripts/make-portable.cjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck"
  },
  "author": "whoisrez",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.10.0",
    "electron": "43.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "madden-franchise": "^4.3.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
